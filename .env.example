# Roonder Portfolio Backend — example env file
# Copy to `.env` and fill in real values. All vars are required unless
# the comment says otherwise; the Joi schema in `src/config/env.config.ts`
# rejects boot when a required var is missing.

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (Supabase / Postgres) ---
DATABASE_URL=postgres://user:pass@localhost:5432/portfolio
# Supabase exposes one database ("postgres") per project; dev/prod
# live in separate schemas within it. Local docker Postgres only has
# "public", so leave this unset (defaults to "public") for local dev.
DB_SCHEMA=dev

# --- Supabase S3-compatible storage (project cover images) ---
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=replace-with-project-region
SUPABASE_S3_ACCESS_KEY_ID=replace-with-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key
SUPABASE_S3_BUCKET=replace-with-bucket-name

# --- JWT (auth) ---
# MUST be at least 32 chars and MUST be distinct from JWT_REFRESH_SECRET.
JWT_SECRET=replace-with-32-or-more-chars-of-random-bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-32-or-more-chars-of-random-bytes
JWT_REFRESH_EXPIRES_IN=2592000

# --- Superuser (seed) ---
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=replace-with-a-strong-password

# --- CORS allowed origin ---
FRONTEND_URL=https://app.example.com

# --- Resend (contact domain) ---
# Already required by the reviews schema (forward-compat). The contact
# domain (T1.1) adds the two new vars below.
RESEND_API_KEY=re_test
# REEMPLAZAR CUANDO SE COMPRE EL DOMINIO
RESEND_FROM_ADDRESS="Roonder Portfolio <hello@yourdomain.com>"
# Destinatario de los mensajes del formulario. Reemplazar cuando se
# compre el dominio.
RESEND_TO_ADDRESS=you@personal.com

# --- Reviews throttler ---
# TTL floor: 1_000 ms. Limit floor: 1. The "disable" knob for tests
# is to set the write limit to 1_000_000.
REVIEWS_THROTTLE_TTL_MS=60000
REVIEWS_THROTTLE_WRITE_LIMIT=5
REVIEWS_THROTTLE_READ_LIMIT=60

# --- Contact throttler ---
# Mirrors the reviews pattern. Set CONTACT_THROTTLE_WRITE_LIMIT to a
# large value (e.g. 1_000_000) to effectively disable the throttler
# in tests.
CONTACT_THROTTLE_TTL_MS=60000
CONTACT_THROTTLE_WRITE_LIMIT=5
CONTACT_THROTTLE_READ_LIMIT=60

# --- Admin throttler ---
# Only POST /auth/login is throttled (brute-force protection); every
# other admin route (refresh/logout/profile, projects writes) uses
# @SkipThrottle() since it already requires a valid credential. Both
# vars are optional — Joi defaults to 60000ms / 10 attempts.
ADMIN_THROTTLE_TTL_MS=60000
ADMIN_THROTTLE_LOGIN_LIMIT=10
